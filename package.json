{
  "name": "tucajero-v3",
  "version": "3.0.0",
  "private": true,
  "description": "TuCajero Punto de Venta - Versión 3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npx tsx scripts/dev-electron.ts\"",
    "dev:renderer": "vite",
    "dev:electron": "npx tsx scripts/dev-electron.ts",
    "build": "npm run clean && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "npx tsx scripts/build-electron.ts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:backfill": "npx tsx app/main/scripts/backfill-accounts.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf dist release",
    "typecheck": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.43.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.400.0",
    "node-thermal-printer": "^4.3.4",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.18.0",
    "pino": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.0",
    "systeminformation": "^5.22.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.46.1",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
